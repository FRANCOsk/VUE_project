{
  "name": "enterprise-delivery-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Responsive Vue dashboard for tracking enterprise delivery health, milestones, and technology coverage.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "npm run type-check && npm run test && vite build",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^7.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.0",
    "vitest": "^4.0.8",
    "vue-tsc": "^3.2.0"
  }
}
