{
  "name": "enterprise-delivery-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Responsive Vue dashboard for tracking enterprise delivery health, milestones, and technology coverage.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "npm run type-check && npm run test && vite build",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
